#!/bin/sh
# /usr/local/bin/netshare - Milk-V Duo S (SG2000) USB Network Sharing (Tethering) Controller
# Spec: specs/modules/duos-kernel-7.3-mainline.spec.md (SPEC-K73-009)

DNSMASQ_CONF="${DNSMASQ_CONF:-/etc/dnsmasq.conf}"
STATE_FILE="${STATE_FILE:-/var/run/netshare.state}"

restart_dnsmasq() {
    if [ -x /etc/init.d/S80dnsmasq ]; then
        /etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
    else
        killall -HUP dnsmasq 2>/dev/null || true
    fi
}

enable_share() {
    echo "[netshare] 正在开启 USB 网络共享 (Tethering Mode)..."
    
    # 1. 确保内核 IP 转发开启
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true

    # 2. 动态更新 dnsmasq 广播默认网关与 DNS
    cat << 'EOF' > "$DNSMASQ_CONF"
interface=usb0
dhcp-range=192.168.42.2,192.168.42.242,1h
dhcp-option=3,192.168.42.1
dhcp-option=6,192.168.42.1,223.5.5.5
EOF
    restart_dnsmasq

    # 3. 尝试注入 iptables NAT 转发规则 (若内核支持)
    iptables -t nat -A POSTROUTING -o wlan0 -j MASQUERADE >/dev/null 2>&1 || true
    iptables -A FORWARD -i usb0 -o wlan0 -j ACCEPT >/dev/null 2>&1 || true
    iptables -A FORWARD -i wlan0 -o usb0 -m state --state RELATED,ESTABLISHED >/dev/null 2>&1 || true

    echo "on" > "$STATE_FILE"
    echo "[OK] USB 网络共享已成功开启！"
    echo "  - 默认网关 (Gateway): 192.168.42.1"
    echo "  - DNS 服务器 (DNS):   192.168.42.1, 223.5.5.5"
    echo "  - SOCKS5 代理端口:    192.168.42.1:1080"
    echo "  - HTTP PAC 自动配置:  http://192.168.42.1/"
}

disable_share() {
    echo "[netshare] 正在关闭 USB 网络共享，恢复点对点调试模式..."

    # 1. 还原 dnsmasq 纯调试配置 (清空 Option 3 和 6，防止抢占电脑网关)
    cat << 'EOF' > "$DNSMASQ_CONF"
interface=usb0
dhcp-range=192.168.42.2,192.168.42.242,1h
dhcp-option=3
dhcp-option=6
EOF
    restart_dnsmasq

    # 2. 清理 iptables 转发规则
    iptables -t nat -D POSTROUTING -o wlan0 -j MASQUERADE >/dev/null 2>&1 || true
    iptables -D FORWARD -i usb0 -o wlan0 -j ACCEPT >/dev/null 2>&1 || true
    iptables -D FORWARD -i wlan0 -o usb0 -m state --state RELATED,ESTABLISHED >/dev/null 2>&1 || true

    echo "off" > "$STATE_FILE"
    echo "[OK] USB 网络共享已关闭（纯调试模式），电脑网关不会被接管。"
}

show_status() {
    local is_on=0
    if [ -f "$DNSMASQ_CONF" ] && grep -q "dhcp-option=3,192.168.42.1" "$DNSMASQ_CONF"; then
        is_on=1
    fi

    echo "=================================================="
    echo "   Duo S USB 网络共享状态 (SPEC-K73-009)"
    echo "=================================================="
    if [ "$is_on" -eq 1 ]; then
        echo "当前状态:   [开启] USB 共享模式 (Tethering Mode)"
        echo "默认网关:   192.168.42.1 (通过 DHCP 广播推送至宿主机)"
        echo "DNS 服务:   192.168.42.1, 223.5.5.5"
    else
        echo "当前状态:   [关闭] 纯点对点调试模式 (Debug Only)"
        echo "网关广播:   已禁用 (防止抢占宿主机默认网关)"
    fi
    local ip_fwd
    ip_fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo "0")
    echo "内核转发:   net.ipv4.ip_forward = $ip_fwd"
    echo "SOCKS5代理: 192.168.42.1:1080 (全环境免 NAT 即用)"
    echo "Web Portal: http://192.168.42.1/"
    echo "=================================================="
}

case "$1" in
    on|enable|start)
        enable_share
        ;;
    off|disable|stop)
        disable_share
        ;;
    status)
        show_status
        ;;
    *)
        echo "用法: $0 {on|off|status}"
        exit 1
        ;;
esac
exit 0
