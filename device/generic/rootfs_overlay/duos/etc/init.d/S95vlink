#!/bin/sh
#
# vlink proxy client autostart
# - Starts vlink immediately when credentials are provisioned
# - Background time sync loop (HTTP Date header via 223.5.5.5)
#   netguard (S97) 联网后负责 IPv4/DNS，本脚本后台等待网络就绪再同步时钟，
#   时间修正后 vlink 的新 TLS 连接即恢复正常，无需重启守护进程。
# - Security: 镜像内 /etc/vlink/config.json 为无凭据模板，server 为空。
#   cosmos-star (S96) 会在运行后注入真实 ss:// 凭据并负责管理 vlink，
#   本脚本在凭据缺失时仅做时间同步，不启动 vlink（避免 log.Fatal 崩溃循环）。
# - Watchdog: 后台循环监视 config.json，一旦 cosmos-star 注入有效凭据且
#   vlink 未运行，则自动启动 vlink（兼容注入时机不固定的情况）。
#

PROG=/usr/local/bin/vlink
CONF=/etc/vlink/config.json
PIDFILE=/var/run/vlink.pid
LOGFILE=/var/log/vlink.log

# 检查 config 是否已注入有效 ss:// server（非空且以 ss:// 开头）
has_credentials() {
    [ -f "$CONF" ] || return 1
    grep -q '"server"[[:space:]]*:[[:space:]]*"ss://' "$CONF" 2>/dev/null
}

# vlink 是否在运行
vlink_running() {
    pidof vlink >/dev/null 2>&1
}

# 后台循环同步时间直到成功（最多 ~300s），不阻塞启动
sync_clock_loop() {
    i=0
    while [ $i -lt 60 ]; do
        # 1970 时钟下 HTTPS 不可用，只用 HTTP Date 头
        d=$(curl -sI --max-time 4 http://223.5.5.5 2>/dev/null | grep -i '^Date:' | cut -d' ' -f2-)
        if [ -n "$d" ] && date -s "$d" 2>/dev/null; then
            y=$(date +%Y 2>/dev/null)
            [ -n "$y" ] && [ "$y" -ge 2025 ] && { echo "vlink: clock OK ($(date -u +%F\ %T))" >> "$LOGFILE"; return 0; }
        fi
        sleep 5
        i=$((i+1))
    done
    echo "vlink: WARNING clock not synced" >> "$LOGFILE"
    return 1
}

# 后台循环监视凭据注入：凭据出现且 vlink 未运行时自动启动（兼容 cosmos-star 注入）
vlink_watchdog() {
    while :; do
        if has_credentials && ! vlink_running; then
            echo "vlink: credentials detected, starting vlink" >> "$LOGFILE"
            start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$PROG" -- -config "$CONF" >> "$LOGFILE" 2>&1
        fi
        sleep 10
    done
}

start() {
    if [ ! -f "$CONF" ]; then
        echo "ERROR: config $CONF not found"
        exit 1
    fi
    # 时间同步始终执行（不依赖 vlink 凭据）
    sync_clock_loop &
    if has_credentials; then
        echo "Starting vlink..."
        start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$PROG" -- -config "$CONF" >> "$LOGFILE" 2>&1
        echo "vlink started (pid $(cat $PIDFILE 2>/dev/null))"
    else
        echo "vlink: no credentials in $CONF yet, watchdog will start vlink once cosmos-star injects..." | tee -a "$LOGFILE"
    fi
    # 凭据注入监视循环（后台）
    vlink_watchdog &
}

stop() {
    echo "Stopping vlink..."
    start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
    rm -f "$PIDFILE"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
