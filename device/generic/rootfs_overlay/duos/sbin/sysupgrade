#!/bin/sh
# =============================================================================
# sysupgrade - Milk-V Duo S (SG2000) 板端原地固件升级命令行门面
# 
# 动态感知版本，深度集成 cosmos-star System Patch 机制 (SPEC-K73-008)
# 零 hardcode 固件版本，支持任意版本原地热升级、空间准入检查与一键安全回滚
# =============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

show_usage() {
    cat << EOF
用法:
  sysupgrade [选项] <patch_bundle.tar.gz>

选项:
  -c, --check       仅核验固件补丁包与设备存储准入，不执行修改
  -r, --rollback    一键安全回滚至上一版本引导与驱动配置
  -n, --no-reboot   升级完成后不自动重启
  -h, --help        显示帮助信息

示例:
  sysupgrade /root/duos-firmware_polaris_v1.0.0.tar.gz
  sysupgrade -c /root/duos-firmware_polaris_v1.0.0.tar.gz
  sysupgrade -r
EOF
}

CHECK_ONLY=0
ROLLBACK=0
NO_REBOOT=0
BUNDLE_PKG=""

while [ $# -gt 0 ]; do
    case "$1" in
        -c|--check)
            CHECK_ONLY=1
            shift
            ;;
        -r|--rollback|--revert)
            ROLLBACK=1
            shift
            ;;
        -n|--no-reboot)
            NO_REBOOT=1
            shift
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        *)
            if [ -z "$BUNDLE_PKG" ]; then
                BUNDLE_PKG="$1"
            else
                echo -e "${RED}错误: 未知多余参数: $1${NC}"
                show_usage
                exit 1
            fi
            shift
            ;;
    esac
done

# 1. 动态安全回滚分支
if [ "$ROLLBACK" -eq 1 ]; then
    echo -e "${YELLOW}==== 正在触发系统安全回滚至上一版本状态 ====${NC}"
    
    # 优先检测 cosmos-star bundle revert
    if command -v cosmos-star >/dev/null 2>&1; then
        echo -e "${BLUE}==> 调用 cosmos-star bundle revert 引擎...${NC}"
        cosmos-star bundle revert sysupgrade-kernel 2>/dev/null || true
    fi

    # 原生保障回滚
    REVERTED=0
    if [ -b "/dev/mmcblk0p1" ] && [ -f "/root/boot_emmc.bak_prev" ]; then
        echo -e "${GREEN}==> 正在从 /root/boot_emmc.bak_prev 还原 eMMC 引导裸分区 (/dev/mmcblk0p1) ...${NC}"
        dd if="/root/boot_emmc.bak_prev" of=/dev/mmcblk0p1 bs=1M status=none
        REVERTED=1
    elif [ -b "/dev/mmcblk0p1" ] && [ -f "/root/boot_emmc.bak_initial" ]; then
        echo -e "${GREEN}==> 正在从 /root/boot_emmc.bak_initial 还原 eMMC 引导裸分区 (/dev/mmcblk0p1) ...${NC}"
        dd if="/root/boot_emmc.bak_initial" of=/dev/mmcblk0p1 bs=1M status=none
        REVERTED=1
    fi

    RESTORE_SRC=""
    if [ -f "/boot/boot.sd.bak_prev" ]; then
        RESTORE_SRC="/boot/boot.sd.bak_prev"
    elif [ -f "/boot/boot.sd.bak_initial" ]; then
        RESTORE_SRC="/boot/boot.sd.bak_initial"
    else
        RESTORE_SRC=$(ls -1 /boot/boot.sd.bak* 2>/dev/null | head -n 1 || true)
    fi

    if [ -n "$RESTORE_SRC" ] && [ -f "$RESTORE_SRC" ]; then
        echo -e "${GREEN}==> 正在还原引导镜像: $RESTORE_SRC -> /boot/boot.sd ...${NC}"
        cp -f "$RESTORE_SRC" "/boot/boot.sd"
        REVERTED=1
    fi

    # 动态恢复可能被禁用的驱动加载脚本
    DISABLED_SCRIPT=""
    if [ -f "/mnt/system/ko/loadsystemko.sh.disabled" ]; then
        DISABLED_SCRIPT="/mnt/system/ko/loadsystemko.sh.disabled"
    else
        DISABLED_SCRIPT=$(ls -1 /mnt/system/ko/loadsystemko.sh.bak* 2>/dev/null | head -n 1 || true)
    fi

    if [ -n "$DISABLED_SCRIPT" ] && [ -f "$DISABLED_SCRIPT" ]; then
        echo -e "${GREEN}==> 正在恢复历史驱动加载脚本: $DISABLED_SCRIPT -> /mnt/system/ko/loadsystemko.sh ...${NC}"
        mv -f "$DISABLED_SCRIPT" "/mnt/system/ko/loadsystemko.sh"
        chmod +x "/mnt/system/ko/loadsystemko.sh"
        REVERTED=1
    fi

    if [ "$REVERTED" -eq 1 ]; then
        sync
        echo -e "${GREEN}✅ 回滚完成！请重启设备使还原的引导镜像生效。${NC}"
        exit 0
    else
        echo -e "${RED}错误: 未找到可用的历史引导备份 (/boot/boot.sd.bak*)，无法回滚。${NC}"
        exit 1
    fi
fi

# 2. 检查升级包参数
if [ -z "$BUNDLE_PKG" ]; then
    echo -e "${RED}错误: 请指定升级固件包路径 (.tar.gz)${NC}"
    show_usage
    exit 1
fi

if [ ! -f "$BUNDLE_PKG" ]; then
    echo -e "${RED}错误: 固件包不存在: $BUNDLE_PKG${NC}"
    exit 1
fi

# 3. 解包沙盒与动态元数据校验
STAGE_DIR=$(mktemp -d /tmp/.sysupgrade_stage_XXXXXX)
cleanup() {
    rm -rf "$STAGE_DIR"
}
trap cleanup EXIT

echo -e "${BLUE}==> 正在解压升级补丁包: $BUNDLE_PKG ...${NC}"
tar -xzf "$BUNDLE_PKG" -C "$STAGE_DIR"

# 动态查找 bundle 根目录与 manifest
BUNDLE_ROOT=""
for d in "$STAGE_DIR"/*; do
    if [ -f "$d/manifest.json" ]; then
        BUNDLE_ROOT="$d"
        break
    fi
done

if [ -z "$BUNDLE_ROOT" ]; then
    echo -e "${RED}错误: 固件包格式非法，未找到 manifest.json${NC}"
    exit 1
fi

# 提取升级包元数据 (代号体系与双层版本)
PKG_NAME=$(grep -o '"name": *"[^"]*"' "$BUNDLE_ROOT/manifest.json" 2>/dev/null | cut -d'"' -f4 || echo "duos-firmware")
CODENAME=$(grep -o '"codename": *"[^"]*"' "$BUNDLE_ROOT/manifest.json" 2>/dev/null | cut -d'"' -f4 || echo "")
PKG_VER=$(grep -o '"version": *"[^"]*"' "$BUNDLE_ROOT/manifest.json" 2>/dev/null | cut -d'"' -f4 || echo "unknown")
KERNEL_VER=$(grep -o '"kernel_version": *"[^"]*"' "$BUNDLE_ROOT/manifest.json" 2>/dev/null | cut -d'"' -f4 || echo "unknown")
CURR_VER=$(uname -r 2>/dev/null || echo "unknown")

if [ -n "$CODENAME" ]; then
    echo -e "${BLUE}==> 固件包: ${PKG_NAME} [${CODENAME}] | 目标固件: v${PKG_VER} (内核底座: ${KERNEL_VER}) | 当前运行: ${CURR_VER}${NC}"
else
    echo -e "${BLUE}==> 固件包: ${PKG_NAME} | 目标固件: v${PKG_VER} (内核底座: ${KERNEL_VER}) | 当前运行: ${CURR_VER}${NC}"
fi

# 校验 check 钩子
if [ -x "$BUNDLE_ROOT/hooks/check.sh" ]; then
    echo -e "${BLUE}==> 正在执行前置准入校验 (hooks/check.sh)...${NC}"
    if ! "$BUNDLE_ROOT/hooks/check.sh"; then
        echo -e "${RED}❌ 前置准入校验失败，终止升级流程！${NC}"
        exit 1
    fi
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
    echo -e "${GREEN}✅ 固件补丁包校验通过，准入条件满足！(校验模式结束)${NC}"
    exit 0
fi

# 4. 执行升级事务
if [ -n "$CODENAME" ]; then
    echo -e "${YELLOW}==== 开始执行固件升级事务 ([${CODENAME}] v${PKG_VER} / 内核: ${KERNEL_VER}) ====${NC}"
else
    echo -e "${YELLOW}==== 开始执行固件升级事务 (v${PKG_VER} / 内核: ${KERNEL_VER}) ====${NC}"
fi
export SYSUPGRADE_NO_REBOOT="$NO_REBOOT"

if [ -x "$BUNDLE_ROOT/hooks/apply.sh" ]; then
    echo -e "${BLUE}==> 正在应用升级补丁 (hooks/apply.sh)...${NC}"
    "$BUNDLE_ROOT/hooks/apply.sh"
else
    echo -e "${RED}错误: 缺少 hooks/apply.sh 部署钩子${NC}"
    exit 1
fi

# 5. 执行后置完整性验证
if [ -x "$BUNDLE_ROOT/hooks/test.sh" ]; then
    echo -e "${BLUE}==> 正在执行生效验证 (hooks/test.sh)...${NC}"
    if ! "$BUNDLE_ROOT/hooks/test.sh"; then
        echo -e "${RED}❌ 后置验证失败！正在自动触发事务回滚以保护系统...${NC}"
        if [ -x "$BUNDLE_ROOT/hooks/revert.sh" ]; then
            "$BUNDLE_ROOT/hooks/revert.sh"
        fi
        exit 1
    fi
fi

echo -e "${GREEN}==========================================================${NC}"
if [ -n "$CODENAME" ]; then
    echo -e "${GREEN}✅ 固件升级已顺利完成 (已部署: [${CODENAME}] v${PKG_VER} / Linux ${KERNEL_VER})！${NC}"
else
    echo -e "${GREEN}✅ 固件升级已顺利完成 (已部署: v${PKG_VER} / Linux ${KERNEL_VER})！${NC}"
fi
echo -e "${GREEN}==========================================================${NC}"

exit 0
