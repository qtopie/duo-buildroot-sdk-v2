Fix build with C23: 'bool' is now a keyword

C23 makes 'bool' a reserved keyword, which breaks dbus-glib 0.112
where a local variable is named 'bool'. Rename it to 'bval'.

Signed-off-by: qtopierw <qtopierw@localhost>
---
 dbus/dbus-gvalue.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/dbus/dbus-gvalue.c b/dbus/dbus-gvalue.c
index 534e90a..6dc091b 100644
--- a/dbus/dbus-gvalue.c
+++ b/dbus/dbus-gvalue.c
@@ -545,11 +545,11 @@
     {
     case DBUS_TYPE_BOOLEAN:
       {
-	dbus_bool_t bool;
+	dbus_bool_t bval;
         if (!G_VALUE_HOLDS (value, G_TYPE_BOOLEAN))
           goto invalid_type;
-	dbus_message_iter_get_basic (iter, &bool);
-	g_value_set_boolean (value, bool);
+	dbus_message_iter_get_basic (iter, &bval);
+	g_value_set_boolean (value, bval);
 	return TRUE;
       }
     case DBUS_TYPE_BYTE:
